# shared secret for runners and clients
PI_TOWER_TOKEN=change-me
# Enables the opt-in Cloud Threads catalog in the Compose persistent volume.
PI_TOWER_DATA_DIR=/data
# Managed mode limits, in bytes unless noted otherwise.
PI_MANAGED_TEXT_BYTES=262144
PI_TOWER_MANAGED_FRAME_BYTES=524288
PI_TOWER_MAX_SNAPSHOT_BYTES=67108864
PI_TOWER_MAX_SNAPSHOT_TOTAL_BYTES=1073741824
PI_TOWER_MIN_FREE_BYTES=268435456
PI_TOWER_MAX_UPLOADS=2
PI_TOWER_VIEWER_BUFFER_BYTES=1048576
# Optional. When only an authenticating proxy can reach Tower, the header it sets with the person's identity
# (Cloudflare Access: cf-access-authenticated-user-email). Recorded on command receipts as actor.subject.
PI_TOWER_SUBJECT_HEADER=
# Legacy detached-session lifetime. This is separate from managed runner idle sleep.
PI_TOWER_IDLE_TTL=30m
# from Cloudflare Zero Trust: Networks > Tunnels > your tunnel > token
TUNNEL_TOKEN=
