{
	"name": "pi-tower",
	"version": "0.2.0",
	"description": "Control tower for remote pi runners: relay server, runner wrapper, and pi extension",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iamken1204/pi-tower.git"
	},
	"type": "module",
	"pi": {
		"extensions": [
			"./extension.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"bin": {
		"pi-tower": "./tower.mjs",
		"pi-runner": "./runner.mjs",
		"pi-task": "./task.mjs"
	},
	"files": [
		"tower.mjs",
		"runner.mjs",
		"task.mjs",
		"lib.mjs",
		"extension.ts",
		"skills",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"verify": "node test/verify-tower.mjs && node test/verify-chain.mjs && node test/verify-extension.mjs && node test/verify-package.mjs",
		"prepublishOnly": "npm run verify"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"ws": "^8.18.0"
	},
	"peerDependencies": {
		"typebox": "*"
	},
	"devDependencies": {
		"jiti": "^2.4.0"
	}
}
